+#[derive(Default)]
+pub(super) struct Cache(Option<Prepared>);
+
+struct Prepared {
+    device: GpuDevice,
+    metrics: Metrics,
+    frame: Frame,
+    paths: Vec<PreparedSeries>,
+}
+
+struct PreparedSeries {
+    stroke: Path,
+    brush: Brush,
+    fill: Option<(Path, Brush)>,
+}
+
+impl Cache {
+    #[cfg(test)]
+    pub fn ready(&self) -> bool {
+        self.0.is_some()
+    }
+
+    pub fn clear(&mut self) {
+        self.0 = None;
+    }
+
+    fn draw(
+        &mut self,
+        draw: &DrawingSession<'_>,
+        device: &GpuDevice,
+        metrics: Metrics,
+        frame: Frame,
+        series: &[Series],
+    ) -> CanvasResult<()> {
+        let reusable = self.0.as_ref().is_some_and(|prepared| {
+            prepared.device.d2d_device().as_raw() == device.d2d_device().as_raw()
+                && prepared.metrics == metrics
+                && prepared.frame.to - prepared.frame.from == frame.to - frame.from
+                && prepared.frame.min_v == frame.min_v
+                && prepared.frame.max_v == frame.max_v
+        });
+        tracing::trace!(target: "guinea_widgets::chart::cache", hit = reusable, "paths");
+        if !reusable {
+            let mut paths = Vec::new();
+            let to_screen = |time, value| Vector2 {
+                x: frame.x(time, metrics.width),
+                y: frame.y(value, metrics.height),
+            };
+            for line in series.iter().filter(|line| line.points.len() >= 2) {
+                let stroke = build_path(device, line, &to_screen, metrics.height, false)?;
+                let brush = draw.create_solid_brush(line.color)?;
+                let fill = line
+                    .fill
+                    .map(|color| -> CanvasResult<(Path, Brush)> {
+                        Ok((
+                            build_path(device, line, &to_screen, metrics.height, true)?,
+                            draw.create_solid_brush(color)?,
+                        ))
+                    })
+                    .transpose()?;
+                paths.push(PreparedSeries {
+                    stroke,
+                    brush,
+                    fill,
+                });
+            }
+            self.0 = Some(Prepared {
+                device: device.clone(),
+                metrics,
+                frame,
+                paths,
+            });
+        }
+        if let Some(prepared) = &self.0 {
+            let offset = ((prepared.frame.from - frame.from) / (frame.to - frame.from)) as f32
+                * metrics.width;
+            let transform = Matrix3x2::translation(offset, 0.0) * draw.transform();
+            draw.with_transform(&transform, || {
+                for line in &prepared.paths {
+                    if let Some((path, brush)) = &line.fill {
+                        draw.fill_path(path, brush);
+                    }
+                    draw.draw_path(&line.stroke, &line.brush, LINE_WIDTH);
+                }
+            });
+        }
+        Ok(())
+    }
+}
