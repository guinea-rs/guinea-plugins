+    #[test]
+    #[ignore = "manual WARP attribution; reports CPU cycles, not GPU timestamps"]
+    fn attribute_path_build_and_translation_cost() {
+        #[link(name = "kernel32")]
+        unsafe extern "system" {
+            fn GetCurrentThread() -> *mut std::ffi::c_void;
+            fn QueryThreadCycleTime(thread: *mut std::ffi::c_void, cycles: *mut u64) -> i32;
+        }
+        let cycles = || {
+            let mut measured = 0;
+            assert_ne!(
+                unsafe { QueryThreadCycleTime(GetCurrentThread(), &mut measured) },
+                0
+            );
+            measured
+        };
+        let device = GpuDevice::new_warp().unwrap();
+        let target = device.create_render_target(200, 48).unwrap();
+        let metrics = Metrics {
+            width: 200.0,
+            height: 48.0,
+            scale: 1.0,
+        };
+        let line = Series {
+            color: ColorF::WHITE,
+            fill: Some(ColorF {
+                a: 0.25,
+                ..ColorF::WHITE
+            }),
+            interpolation: Interpolation::Linear,
+            points: (0..600)
+                .map(|index| (index * 100, (index % 40) as f32 + 30.0))
+                .collect(),
+        };
+        let anchor = Frame {
+            from: 0.0,
+            to: 60_000.0,
+            min_v: 0.0,
+            max_v: 100.0,
+        };
+        for mode in [
+            "rebuild",
+            "translate-rebuild",
+            "reuse",
+            "reuse",
+            "translate-rebuild",
+            "rebuild",
+        ] {
+            let mut cache = Cache::default();
+            let mut preparation = 0;
+            let mut submission = 0;
+            let started = cycles();
+            for frame_index in 0..300 {
+                let offset = frame_index as f64 * 100.0;
+                let frame = Frame {
+                    from: offset,
+                    to: offset + 60_000.0,
+                    ..anchor
+                };
+                target
+                    .draw(|draw| {
+                        draw.clear(ColorF::TRANSPARENT);
+                        if mode == "reuse" {
+                            let before = cycles();
+                            cache.draw(
+                                draw,
+                                &device,
+                                metrics,
+                                frame,
+                                std::slice::from_ref(&line),
+                            )?;
+                            submission += cycles() - before;
+                        } else {
+                            let before = cycles();
+                            let prepared = if mode == "rebuild" { frame } else { anchor };
+                            let project = |time, value| Vector2 {
+                                x: prepared.x(time, 200.0),
+                                y: prepared.y(value, 48.0),
+                            };
+                            let stroke = build_path(&device, &line, &project, 48.0, false)?;
+                            let fill = build_path(&device, &line, &project, 48.0, true)?;
+                            let brush = draw.create_solid_brush(line.color)?;
+                            let fill_brush = draw.create_solid_brush(line.fill.unwrap())?;
+                            preparation += cycles() - before;
+                            let before = cycles();
+                            let paint = || {
+                                draw.fill_path(&fill, &fill_brush);
+                                draw.draw_path(&stroke, &brush, LINE_WIDTH);
+                            };
+                            if mode == "translate-rebuild" {
+                                let transform = Matrix3x2::translation(
+                                    (-offset / 60_000.0 * 200.0) as f32,
+                                    0.0,
+                                ) * draw.transform();
+                                draw.with_transform(&transform, paint);
+                            } else {
+                                paint();
+                            }
+                            submission += cycles() - before;
+                        }
+                        Ok(())
+                    })
+                    .unwrap();
+            }
+            println!(
+                "{mode}: paints=300 total_cycles={} explicit_prepare_cycles={preparation} submit_or_cache_cycles={submission}",
+                cycles() - started
+            );
+        }
+    }
