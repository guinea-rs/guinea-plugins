+    #[test]
+    fn cached_live_paths_match_rebuilt_paths_across_frames() {
+        let device = GpuDevice::new_warp().unwrap();
+        let cached = device.create_render_target(200, 48).unwrap();
+        let reference = device.create_render_target(200, 48).unwrap();
+        let metrics = Metrics {
+            width: 200.0,
+            height: 48.0,
+            scale: 1.0,
+        };
+        for (interpolation, light) in [
+            Interpolation::Linear,
+            Interpolation::Step,
+            Interpolation::Smooth,
+        ]
+        .into_iter()
+        .flat_map(|interpolation| [false, true].map(|light| (interpolation, light)))
+        {
+            let color = if light { ColorF::BLACK } else { ColorF::WHITE };
+            let series = vec![Series {
+                color,
+                fill: Some(ColorF { a: 0.25, ..color }),
+                interpolation,
+                points: (0..600)
+                    .map(|index| (index * 100, (index % 40) as f32 + 30.0))
+                    .collect(),
+            }];
+            let options = LineChartOptions {
+                background: Some(if light { ColorF::WHITE } else { ColorF::BLACK }),
+                border: Some(color),
+                corner_radius: Some(6.0),
+                grid: Some(ChartGrid {
+                    every_t: Some(10_000),
+                    at_v: vec![50.0],
+                    color,
+                }),
+                x_window: Some(60_000),
+                y_range: Some((0.0, 100.0)),
+                live: Some(super::super::model::Live {
+                    per_second: 1000.0,
+                    lag: 1000,
+                }),
+            };
+            let mut cache = Cache::default();
+            let mut original = None;
+            for end in [60_000.0, 60_100.0, 61_000.0] {
+                cached
+                    .draw(|draw| {
+                        draw.clear(ColorF::TRANSPARENT);
+                        let transform = Matrix3x2::translation(3.0, 2.0);
+                        draw.set_transform(&transform);
+                        render(
+                            draw,
+                            &device,
+                            metrics,
+                            &series,
+                            &options,
+                            Some(end),
+                            &mut cache,
+                        );
+                        assert_eq!(draw.transform(), transform);
+                        Ok(())
+                    })
+                    .unwrap();
+                let path = cache.0.as_ref().unwrap().paths[0].stroke.raw().as_raw();
+                if let Some(original) = original {
+                    assert_eq!(path, original);
+                }
+                original = Some(path);
+                let plain = LineChartOptions {
+                    live: None,
+                    ..options.clone()
+                };
+                reference
+                    .draw(|draw| {
+                        draw.clear(ColorF::TRANSPARENT);
+                        draw.set_transform(&Matrix3x2::translation(3.0, 2.0));
+                        render(
+                            draw,
+                            &device,
+                            metrics,
+                            &series,
+                            &plain,
+                            Some(end),
+                            &mut Cache::default(),
+                        );
+                        Ok(())
+                    })
+                    .unwrap();
+                let actual = cached.read_pixels().unwrap();
+                let expected = reference.read_pixels().unwrap();
+                let worst = actual
+                    .iter()
+                    .zip(&expected)
+                    .map(|(actual, expected)| actual.abs_diff(*expected))
+                    .max()
+                    .unwrap();
+                let total: u64 = actual
+                    .iter()
+                    .zip(&expected)
+                    .map(|(actual, expected)| u64::from(actual.abs_diff(*expected)))
+                    .sum();
+                let mean = total as f64 / actual.len() as f64;
+                assert!(
+                    worst <= 4 && mean <= 0.01,
+                    "{interpolation:?} end={end}: worst={worst}, mean={mean}"
+                );
+            }
+        }
+    }
